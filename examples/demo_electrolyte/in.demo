# Demo: binary Lennard-Jones mixture (toy electrolyte model)
# Type 1 = "solvent", Type 2 = "ion" (minority species, 10%)

units       lj
atom_style  atomic
dimension   3
boundary    p p p

lattice     fcc 0.6
region      box block 0 10 0 10 0 10
create_box  2 box
create_atoms 1 box

set         type 1 type/fraction 2 0.10 12345

mass        1 1.0
mass        2 1.0

pair_style  lj/cut 2.5
pair_coeff  1 1 1.0 1.0 2.5
pair_coeff  2 2 1.5 1.0 2.5
pair_coeff  1 2 1.2 1.0 2.5

velocity    all create 1.5 87287

fix         1 all nve
fix         2 all langevin 1.5 1.5 1.0 12345

timestep    0.005

thermo      500
thermo_style custom step temp press pe

dump        1 all custom 100 dump.electrolyte.lammpstrj id type x y z
dump_modify 1 sort id

dump        2 all custom 100 dump.electrolyte.unwrapped.lammpstrj id type xu yu zu
dump_modify 2 sort id

run         20000